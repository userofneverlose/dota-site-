@model WebApplication14.Models.RegisterModel
@{
    ViewData["Title"] = "Регистрация";
}

<h1>Регистрация</h1>

<div class="block">
    <form asp-action="Register" method="post">
        <p>Имя: <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name"></span></p>
        <p>Email: <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email"></span></p>
        <p>Пароль: <input asp-for="Password" type="password" class="form-control" />
            <span asp-validation-for="Password"></span></p>
        <p>Повторите пароль: <input asp-for="ConfirmPassword" type="password" class="form-control" />
            <span asp-validation-for="ConfirmPassword"></span></p>
        <button type="submit" class="btn btn-primary">Зарегистрироваться</button>
    </form>
</div>