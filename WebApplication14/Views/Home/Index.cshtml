@model List<WebApplication14.Models.Item>
@{
    ViewData["Title"] = "Главная";
    ViewData["Description"] = "Сайт с информацией об игре Dota 2: герои, предметы и советы.";
}

<h1>Dota 2 - информация об игре</h1>

<div class="block">
    <p>Добро пожаловать на сайт про Dota 2. Здесь вы найдёте советы по предметам и ответы на вопросы новичков.</p>
</div>

<img src="~/images/dota.jpg" alt="Dota 2" class="img-fluid">

<div class="block">
    <h2>Что есть на сайте</h2>
    <ul>
        <li>Информация о предметах</li>
        <li>Ответы на частые вопросы</li>
        <li>Отзывы игроков</li>
    </ul>
</div>

<div class="block">
    <h2>Почему Dota 2</h2>
    <p>Это бесплатная командная игра, в которую играют миллионы людей по всему миру.</p>
</div>
<h2>Популярные предметы</h2>
@foreach (var item in Model)
{
    <partial name="_Card" model="item" />
}
<p><a class="btn btn-primary" asp-controller="Home" asp-action="About">Узнать больше</a></p>